
model User {
  id            String    @id @default(cuid())
  email         String   @unique
  passwordHash  String?

  theme  String?
  locale  String?
  status          StatusUser @default(NOACTIVE)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions      SessionUser[]
  resetPasswordToken      ResetPasswordTokenUser?
  activateToken      ActivateTokenUser?

  @@map("users")
}